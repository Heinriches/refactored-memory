<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio_010"/>
        <attribute name="authors" value="steamuser"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-27 09:27:49 PM"/>

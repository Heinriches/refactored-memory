    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Integer" array="False" size=""/>
            <declare name="b" type="Integer" array="False" size=""/>
            <declare name="c" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o valor do coeficiente 'a'.&quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;Digite o valor do coeficiente 'b'.&quot;" newline="True"/>
            <input variable="b"/>
            <output expression="&quot;Digite o valor do coeficiente 'c'.&quot;" newline="True"/>
            <input variable="c"/>
            <output expression="&quot;DELTA = &quot; &amp;ToFixed(((b * b) - (4 * a * c)), 2) &amp;&quot;.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>

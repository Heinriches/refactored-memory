    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="largura" type="Real" array="False" size=""/>
            <declare name="altura" type="Real" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor da LARGURA da parede, em metros: &quot;" newline="True"/>
            <input variable="largura"/>
            <output expression="&quot;Digite o valor da ALTURA da parede, em metros: &quot;" newline="True"/>
            <input variable="altura"/>
            <assign variable="area" expression="(largura * altura)"/>
            <output expression="&quot;&#193;REA a ser pintada = &quot; &amp;area &amp;&quot;m&#178;.&quot;" newline="True"/>
            <output expression="&quot;TINTA a ser usada = &quot; &amp;ToFixed((area / 2), 2) &amp;&quot; litros.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
